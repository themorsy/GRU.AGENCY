---
import type {CollectionEntry} from 'astro:content';
import SectionHeading from './SectionHeading.astro';
interface Props {c:CollectionEntry<'locales'>['data']}
const {c}=Astro.props;
---
<section id="work" class="section portfolio" aria-labelledby="work-heading">
  <div class="section-top"><SectionHeading eyebrow={c.portfolio.eyebrow} title={c.portfolio.title} id="work-heading"/><p class="section-note">{c.portfolio.note}</p></div>
  <div class="project-grid">{c.portfolio.projects.map(project=><article class="project-card">
    <a href={project.caseStudyUrl||`#${project.id}`} data-project-open={project.id} aria-haspopup="dialog" aria-controls="project-lightbox">
      <div class="project-visual">{project.image?<img src={project.image} alt={project.imageAlt||project.name} width="800" height="600" loading="lazy" decoding="async"/>:<span>{c.portfolio.placeholder}</span>}</div>
      <h3>{project.name}</h3><p class="project-category">{project.category}</p>
    </a>
    <template id={project.id}>
      <div class="lightbox-visual">{project.fullImage||project.image?<img src={project.fullImage||project.image} alt={project.imageAlt||project.name} width="1200" height="900" decoding="async"/>:<span>{c.portfolio.placeholder}</span>}</div>
      <div class="lightbox-detail"><p class="eyebrow">{project.category}</p><h2 id="lightbox-title">{project.name}</h2><p>{project.body}</p>{project.caseStudyUrl&&<a class="case-study-link" href={project.caseStudyUrl}>{c.portfolio.caseStudy}<span aria-hidden="true"> ↗</span></a>}</div>
    </template>
    <noscript><details><summary>{project.name}</summary><p>{project.body}</p>{project.caseStudyUrl&&<a href={project.caseStudyUrl}>{c.portfolio.caseStudy}</a>}</details></noscript>
  </article>)}</div>
</section>
<dialog id="project-lightbox" class="lightbox" aria-labelledby="lightbox-title">
  <button class="dialog-close" data-lightbox-close aria-label={c.ui.close}>×</button>
  <div class="lightbox-content"></div>
</dialog>
<script>import '../scripts/lightbox';</script>
