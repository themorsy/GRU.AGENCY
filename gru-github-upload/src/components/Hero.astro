---
import type {CollectionEntry} from 'astro:content';
import Text from './Text.astro';
interface Props {c:CollectionEntry<'locales'>['data']}
const {c}=Astro.props;
---
<section class="hero" aria-labelledby="hero-heading">
  {c.hero.poster&&<img class="hero-poster" src={c.hero.poster} width="1920" height="1080" alt="" decoding="async"/>}
  {c.hero.video?<video class="hero-video" data-video data-src={c.hero.video} poster={c.hero.poster} preload="none" muted loop playsinline aria-hidden="true" tabindex="-1"/>:<div class="hero-video-slot" aria-hidden="true"><span>{c.hero.videoLabel}<small>{c.hero.videoStatus}</small></span></div>}
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="hero-content"><h1 id="hero-heading"><Text value={c.hero.headline}/></h1><p><Text value={c.hero.body}/></p><div class="hero-actions"><a class="button" href="#lead">{c.ui.book}</a><a class="button button-outline" href="#work">{c.ui.work}</a></div></div>
</section>
