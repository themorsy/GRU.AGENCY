---
import type {CollectionEntry} from 'astro:content';
import SectionHeading from './SectionHeading.astro';
interface Props {c:CollectionEntry<'locales'>['data']}
const {c}=Astro.props;
---
<section id="proof" class="section proof" aria-labelledby="proof-heading">
  <SectionHeading eyebrow={c.proof.eyebrow} id="proof-heading"/>
  <div class="stats">{c.proof.stats.map(s=><div class="stat"><span class="accent" aria-hidden="true"></span><div><p class="stat-value display"><bdi dir={c.lang==='ar'&&s.value.includes('جنيه')?'rtl':'ltr'}>{s.value}</bdi></p><p class="stat-label">{s.label}</p></div></div>)}</div>
  <div class="marquee" role="region" aria-label={c.proof.logosLabel} style={`--logo-count:${c.proof.logos.length}`}><div class="marquee-track">{[false,true].map(duplicate=><div class="logo-group" aria-hidden={duplicate?'true':undefined}>{c.proof.logos.map(l=><div class="logo-slot">{l.src?<img src={l.src} alt={duplicate?'':l.alt} width="220" height="66" loading="lazy" decoding="async"/>:<span>{l.alt}</span>}</div>)}</div>)}</div></div>
</section>
