---
import {getCollection} from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Proof from '../../components/Proof.astro';
import Services from '../../components/Services.astro';
import Portfolio from '../../components/Portfolio.astro';
import CtaBand from '../../components/CtaBand.astro';
import ClientValue from '../../components/ClientValue.astro';
import Method from '../../components/Method.astro';
import About from '../../components/About.astro';
import LeadForm from '../../components/LeadForm.astro';
import Footer from '../../components/Footer.astro';
export async function getStaticPaths(){return (await getCollection('locales')).map(entry=>({params:{lang:entry.data.lang},props:{c:entry.data}}));}
const {c}=Astro.props;
---
<Base c={c}><Hero c={c}/><Proof c={c}/><Services c={c}/><Portfolio c={c}/><CtaBand c={c}/><ClientValue c={c}/><Method c={c}/><About c={c}/><LeadForm c={c}/><Footer c={c} slot="footer"/></Base>
