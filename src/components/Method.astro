---
import type {CollectionEntry} from 'astro:content';
import MethodIcon from './MethodIcon.astro';
import SectionHeading from './SectionHeading.astro';
interface Props {c:CollectionEntry<'locales'>['data']}
const {c}=Astro.props;
---
<section id="method" class="section method" aria-labelledby="method-heading"><div class="method-heading"><SectionHeading number={String(c.sectionOrder.filter(k=>!['hero','cta','proof'].includes(k)).indexOf('method')+1).padStart(2,'0')} eyebrow={c.method.eyebrow} title={c.method.title} id="method-heading"/><p class="method-support">{c.method.support}</p></div><ol class="method-grid">{c.method.items.map(step=><li class="method-card" data-reveal tabindex="0"><MethodIcon step={step.num}/><p class="method-number"><bdi dir="ltr">{step.num}</bdi></p><h3>{step.titleBreakAfter ? <>{step.title.slice(0,step.titleBreakAfter)}<wbr/>{step.title.slice(step.titleBreakAfter)}</> : step.title}</h3><p class="method-body">{step.body}</p></li>)}</ol></section>

