---
/**
 * §9 Who We Are.
 *
 * Tint ground, 96px 56px, single column max-width 860px, 22px gaps. Sits
 * immediately before the form on every layout, desktop and mobile.
 *
 * The statement is a paragraph in the design, not a heading, so the H2 the
 * heading structure requires is present but visually hidden.
 */
import Arches from './Arches.astro';
import { getContent, type Locale } from '../content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = getContent(locale);
---

<section id="who-we-are" class="who" aria-labelledby="who-heading">
  <div class="who__inner">
    <Arches />
    <span class="eyebrow">{c.whoWeAre.eyebrow}</span>
    <h2 id="who-heading" class="visually-hidden">{c.whoWeAre.eyebrow}</h2>
    <p class="who__statement">{c.whoWeAre.statement}</p>
    <p class="who__body">{c.whoWeAre.body}</p>
  </div>
</section>

<style>
  .who {
    background: var(--tint);
    padding: var(--section-y) var(--gutter);
  }

  .who__inner {
    max-width: 860px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .who__statement {
    font-family: var(--ff-display);
    font-weight: var(--fw-display);
    font-size: var(--fs-statement);
    line-height: var(--lh-statement);
    letter-spacing: var(--ls-display);
    text-transform: var(--tt-display);
    text-wrap: pretty;
  }

  .who__body {
    font-weight: 300;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    color: var(--body);
    max-width: 620px;
  }

  :global(html[lang='ar']) .who__inner {
    max-width: 900px;
  }
  :global(html[lang='ar']) .who__body {
    max-width: 680px;
  }

  @media (max-width: 767px) {
    .who__inner {
      gap: 16px;
    }
  }
</style>
