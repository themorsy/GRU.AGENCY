---
/**
 * §11 Footer.
 *
 * #0B0B0B ground, cream text, 72px 56px 40px, 4-column grid 1.4fr 1fr 1fr 1fr
 * with a 40px gap, then a bottom bar above a rgba(241,239,219,.15) rule.
 *
 * "Adholic" appears nowhere — it was in the old footer and the change list
 * removes it. There is no reference to it anywhere in this codebase.
 *
 * Social links are text labels, exactly as the design shows them. The handoff
 * asks for the brand's own icon set, which is still outstanding: when it
 * arrives, each entry in site.socials already carries an `icon` key to hang it
 * on. TikTok has no URL yet, so it renders as plain text rather than a dead
 * link.
 */
import { getContent, homeHref, site, type Locale } from '../content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = getContent(locale);
---

<footer class="footer on-dark" data-gru-footer>
  <div class="footer__brand">
    <img src={site.logoCream} alt={site.brand} width="145" height="46" class="footer__logo" loading="lazy" decoding="async" />
    <p class="footer__blurb">{c.footer.blurb}</p>
  </div>

  <nav class="footer__col" aria-label={c.footer.sitemapLabel}>
    <span class="footer__label">{c.footer.sitemapLabel}</span>
    {c.nav.map((n) => <a href={n.href} class="footer__link">{n.label}</a>)}
  </nav>

  <div class="footer__col">
    <span class="footer__label">{c.footer.contactLabel}</span>
    <a href={`mailto:${site.email}`} class="footer__link ltr" dir="ltr">{site.email}</a>
    <a href={site.phoneHref} class="footer__link ltr" dir="ltr">{site.phoneDisplay}</a>
    <a
      href={site.whatsappHref}
      class="footer__pill"
      target="_blank"
      rel="noopener noreferrer">{c.footer.whatsappCta}</a
    >
  </div>

  <div class="footer__col">
    <span class="footer__label">{c.footer.followLabel}</span>
    {
      site.socials.map((s) =>
        s.href ? (
          <a href={s.href} class="footer__link" target="_blank" rel="noopener noreferrer">
            {s.label}
          </a>
        ) : (
          <span class="footer__link footer__link--pending">{s.label}</span>
        ),
      )
    }
  </div>

  <div class="footer__bar">
    <span>{c.footer.copyright}</span>
    <p class="footer__lang" dir="ltr">
      <a href={homeHref('en')} hreflang="en" class="footer__lang-item">EN</a><span
        aria-hidden="true"> / </span
      ><a href={homeHref('ar')} hreflang="ar" class="footer__lang-item">AR</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink-soft);
    color: var(--on-dark);
    padding: var(--footer-pt) var(--gutter) var(--footer-pb);
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 40px;
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .footer__logo {
    height: 46px;
    width: auto;
  }

  .footer__blurb {
    font-weight: 300;
    font-size: var(--fs-body-sm);
    line-height: 1.7;
    color: var(--on-dark-quiet);
    max-width: 280px;
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }

  .footer__label {
    font-size: var(--fs-micro);
    letter-spacing: 0.2em;
    text-transform: var(--tt-ui);
    color: var(--on-dark-hair);
  }

  .footer__link {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    font-weight: 300;
    font-size: var(--fs-body-sm);
    color: rgba(241, 239, 219, 0.85);
  }
  .footer__link:hover {
    color: var(--cream);
  }
  .footer__link--pending {
    color: var(--on-dark-faint);
    cursor: default;
  }

  .footer__pill {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    padding: 9px 18px;
    border: 1px solid var(--on-dark-outline);
    border-radius: var(--r-pill);
    font-weight: 300;
    font-size: var(--fs-body-sm);
    color: var(--cream);
    margin-top: 6px;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .footer__pill:hover {
    background: var(--cream);
    color: var(--ink-soft);
    border-color: var(--cream);
  }

  .footer__bar {
    grid-column: span 4;
    border-top: 1px solid var(--footer-rule);
    padding-top: 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-size: var(--fs-meta);
    letter-spacing: normal;
    color: var(--on-dark-hair);
  }

  .footer__lang {
    display: flex;
    align-items: center;
  }
  .footer__lang-item {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding-inline: 2px;
    color: var(--on-dark-hair);
  }
  .footer__lang-item:hover {
    color: var(--cream);
  }

  /* Touch input: every footer link gets a full 44px target. The designed
     rhythm (14px text on a 12px gap) tops out at a 36px pitch, so the gap
     tightens to 4px and the links grow instead — a change only made where
     fingers are actually the input. */
  @media (pointer: coarse) {
    .footer__col {
      gap: 4px;
    }
    .footer__link {
      min-height: var(--tap-min);
    }
    .footer__lang-item {
      min-height: var(--tap-min);
    }
  }

  @media (max-width: 1023px) {
    .footer {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px;
    }
    .footer__brand {
      grid-column: span 2;
    }
    .footer__bar {
      grid-column: span 2;
    }
  }

  @media (max-width: 767px) {
    .footer {
      grid-template-columns: 1fr;
      gap: 26px;
    }
    .footer__brand,
    .footer__bar {
      grid-column: span 1;
    }
    .footer__bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }
</style>
