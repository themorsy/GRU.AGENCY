---
/**
 * §1 Sticky header — all pages.
 *
 * Cream ground, 1px rule bottom border, 16px/56px padding, position: sticky.
 * Because it is sticky rather than fixed it keeps its box in the flow, so its
 * height is reserved and it can never overlap content when scrolling back up
 * (the change list calls this out explicitly).
 *
 * Hide-on-scroll-down / show-on-scroll-up is implemented natively in
 * ../scripts/header.ts: it writes the transform straight onto the element and
 * keeps no framework state, so scrolling never triggers a re-render.
 */
import { getContent, homeHref, otherLocale, site, type Locale } from '../content';

interface Props {
  locale: Locale;
  /** The thank-you pages show the logo only. */
  minimal?: boolean;
}
const { locale, minimal = false } = Astro.props;
const c = getContent(locale);
const other = otherLocale(locale);
const home = homeHref(locale);
---

<a class="skip-link" href="#main">{c.skipToContent}</a>

<header class="site-header" data-gru-header data-minimal={minimal ? 'true' : 'false'}>
  <div class="site-header__inner">
    <a href={home} class="site-header__logo" aria-label={site.brand}>
      <img src={site.logoGreen} alt={site.logoAlt} width="120" height="38" />
    </a>

    {
      !minimal && (
        <>
          <nav class="site-header__nav" aria-label={c.footer.sitemapLabel}>
            {c.nav.map((n) => (
              <a href={n.href} class="nav-link">
                {n.label}
              </a>
            ))}
          </nav>

          <div class="site-header__actions">
            <p class="lang" dir="ltr" aria-label="Language">
              <a
                href={homeHref('en')}
                hreflang="en"
                lang="en"
                dir="ltr"
                aria-current={locale === 'en' ? 'true' : undefined}
                class:list={['lang__item', { 'lang__item--on': locale === 'en' }]}>EN</a
              ><span class="lang__sep" aria-hidden="true"> / </span><a
                href={homeHref('ar')}
                hreflang="ar"
                lang="ar"
                dir="ltr"
                aria-current={locale === 'ar' ? 'true' : undefined}
                class:list={['lang__item', { 'lang__item--on': locale === 'ar' }]}>AR</a
              >
            </p>
            <a href="#lead" class="btn btn--green btn--sm site-header__cta">{c.headerCta}</a>
            <button
              type="button"
              class="burger"
              data-gru-menu-toggle
              aria-expanded="false"
              aria-controls="gru-mobile-menu">
              <span class="visually-hidden" data-label-open={c.menuOpen} data-label-close={c.menuClose}
                >{c.menuOpen}</span
              >
              <span class="burger__bar" aria-hidden="true"></span>
              <span class="burger__bar" aria-hidden="true"></span>
            </button>
          </div>
        </>
      )
    }
  </div>

  {
    !minimal && (
      <div class="mobile-menu" id="gru-mobile-menu" data-gru-menu hidden>
        <nav class="mobile-menu__nav" aria-label={c.footer.sitemapLabel}>
          {c.nav.map((n) => (
            <a href={n.href} class="mobile-menu__link" data-gru-menu-link>
              {n.label}
            </a>
          ))}
        </nav>
        <div class="mobile-menu__foot">
          <a href={other === 'ar' ? homeHref('ar') : homeHref('en')} hreflang={other} class="link-quiet">
            {c.langSwitch.otherLabel}
          </a>
          <a href="#lead" class="btn btn--green" data-gru-menu-link>{c.headerCta}</a>
        </div>
      </div>
    )
  }
</header>

<style>
  .skip-link {
    position: absolute;
    inset-inline-start: 0;
    top: 0;
    z-index: 300;
    transform: translateY(-120%);
    background: var(--green);
    color: var(--cream);
    padding: 12px 20px;
    font-size: var(--fs-btn);
    letter-spacing: var(--ls-btn);
    text-transform: var(--tt-ui);
    transition: transform 0.2s ease;
  }
  .skip-link:focus-visible {
    transform: translateY(0);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 90;
    background: var(--cream);
    border-bottom: 1px solid var(--rule);
    transition: var(--t-header);
    will-change: transform;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 16px var(--gutter);
  }

  .site-header__logo {
    display: flex;
    align-items: center;
    /* The header row is already 44px tall because of the CTA pill, so giving
       the logo link a 44px hit area costs no layout. */
    min-height: var(--tap-min);
    flex: 0 0 auto;
  }
  .site-header__logo img {
    height: 38px;
    width: auto;
  }

  .site-header__nav {
    display: flex;
    gap: 34px;
    flex-wrap: wrap;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    font-family: var(--ff-body);
    font-weight: 400;
    font-size: var(--fs-nav);
    letter-spacing: var(--ls-nav);
    text-transform: var(--tt-ui);
    color: var(--ink-soft);
  }
  .nav-link:hover {
    color: var(--green);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: 0 0 auto;
  }

  .lang {
    display: flex;
    align-items: center;
    font-size: var(--fs-nav);
    letter-spacing: 0.14em;
    color: var(--green);
    margin: 0;
  }
  .lang__item {
    display: inline-flex;
    align-items: center;
    /* 44px tall. "EN" and "AR" are ~22px wide at the designed size, so each
       link cannot also be 44px WIDE without pulling the two apart and breaking
       the "EN / AR" lockup. They clear WCAG 2.2 AA (24x24); a single-toggle
       variant would be needed for a strict 44x44 per link. */
    min-height: var(--tap-min);
    padding-inline: 4px;
    color: var(--green);
  }
  .lang__item--on {
    font-weight: 500;
  }
  .lang__item:hover {
    color: var(--ink-soft);
  }
  .lang__sep {
    opacity: 0.5;
  }

  /* ---- Mobile ---------------------------------------------------------- */
  .burger {
    display: none;
    width: var(--tap-min);
    height: var(--tap-min);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: var(--r-pill);
    cursor: pointer;
  }
  .burger__bar {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--ink-soft);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .burger[aria-expanded='true'] .burger__bar:first-of-type {
    transform: translateY(3.75px) rotate(45deg);
  }
  .burger[aria-expanded='true'] .burger__bar:last-of-type {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  .mobile-menu {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    background: var(--cream);
    border-top: 1px solid var(--rule);
    padding: 28px var(--gutter) 36px;
    min-height: 60svh;
  }
  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
  }
  .mobile-menu__link {
    display: flex;
    align-items: center;
    min-height: var(--tap-min);
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
    font-family: var(--ff-display);
    font-weight: var(--fw-display);
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    letter-spacing: var(--ls-display);
    text-transform: var(--tt-display);
    color: var(--ink-soft);
  }
  .mobile-menu__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  @media (max-width: 1023px) {
    .site-header__nav {
      display: none;
    }
    .burger {
      display: flex;
    }
    .mobile-menu[data-open='true'] {
      display: flex;
    }
  }

  @media (max-width: 767px) {
    .site-header__cta,
    .lang {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }
</style>

<script>
  import '../scripts/header';
</script>
