---
import type {CollectionEntry} from 'astro:content';
interface Props{c:CollectionEntry<'locales'>['data'];minimal?:boolean;slug?:string;languages?:('en'|'ar')[]}
const {c,minimal=false,slug='',languages=['en','ar']}=Astro.props;
const home=`/${c.lang}/${slug?slug+'/':''}`;
const other=c.lang==='en'?'ar':'en';
const alternate=languages.includes(other)?`/${other}/${slug?slug+'/':''}`:`/${other}/`;
const targets={method:'method',services:'services',value:'value',proof:'proof',about:'about',lead:'form',work:'portfolio'};
const href=(value:string)=>value.startsWith('#')?(c.sectionOrder.includes(targets[value.slice(1) as keyof typeof targets] as any)?home:`/${c.lang}/`)+value:value;
---
<div class="header-reserve"><header class="site-header" data-header><div class="header-inner"><a class="brand" href={home}><img src={minimal?"/assets/logo-green.png":"/assets/logo-cream.png"} data-header-logo width="112" height="47" alt={c.logoAlt}/></a>{!minimal&&<><nav class="desktop-nav" aria-label={c.ui.navigation}>{c.nav.map(n=><a href={href(n.href)}>{n.label}</a>)}</nav><div class="header-actions"><a class="language" href={alternate} aria-label={c.ui.language}><bdi dir="ltr">{c.ui.languagePair}</bdi></a><a class="button button-arrow" href={href('#lead')}>{c.ui.book}</a></div><button class="menu-toggle" aria-label={c.ui.menu} aria-expanded="false" aria-controls="mobile-menu" data-menu-open><span></span><span></span></button></>}</div></header></div>
{!minimal&&<dialog id="mobile-menu" class="mobile-menu" aria-label={c.ui.navigation}><button class="dialog-close" data-menu-close aria-label={c.ui.close}></button><nav aria-label={c.ui.navigation}>{c.nav.map(n=><a href={href(n.href)}>{n.label}</a>)}</nav><a class="language" href={alternate}>{c.ui.language}</a><a class="button button-arrow" href={href('#lead')}>{c.ui.book}</a></dialog>}


