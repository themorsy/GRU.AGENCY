---
import Arches from './Arches.astro';
import Text from './Text.astro';
interface Props { eyebrow:string; title?:string; id?:string;number?:string }
const {eyebrow,title,id,number}=Astro.props;
---
<div class="section-heading"><Arches/><p class="eyebrow" id={!title?id:undefined}>{number&&<bdi class="section-label-number" dir="ltr">{number}</bdi>}<Text value={eyebrow}/></p>{title&&<h2 id={id}><Text value={title}/></h2>}</div>
