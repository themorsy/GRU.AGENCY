---
/**
 * §5 Selected Work — gallery + lightbox.
 *
 * Cream ground, 96px 56px. 3-column grid, 24px gap, six cards. Each card is an
 * arch-topped 4/3 image slot (180px 180px 4px 4px) above the project name and
 * a green category label. Mobile drops to 2 columns, 12px gap, 80px arch.
 *
 * The lightbox is a native <dialog> opened with showModal(), which gives the
 * focus trap and Esc handling from the platform rather than from hand-written
 * key juggling. Overlay clicks and focus restore are wired in
 * ../scripts/lightbox.ts; scroll lock is a body class.
 *
 * All six detail panels are rendered as real HTML inside the dialog rather
 * than injected from a JS object, so every word — including the case-study
 * summaries — is crawlable text, per the change list.
 */
import Arches from './Arches.astro';
import { caseStudyHref, getContent, type Locale } from '../content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = getContent(locale);
const projects = c.work.projects;
---

<section id="work" class="work" aria-labelledby="work-heading">
  <div class="section-head">
    <div class="opener">
      <Arches />
      <span class="eyebrow">{c.work.eyebrow}</span>
      <h2 id="work-heading" class="h2">{c.work.heading}</h2>
    </div>
    <span class="section-note">{c.work.note}</span>
  </div>

  <ul class="grid">
    {
      projects.map((p) => (
        <li>
          <button
            type="button"
            class="card"
            data-gru-lightbox-open={p.slug}
            aria-haspopup="dialog">
            <span class="card__slot">
              {p.image ? (
                <img
                  src={p.image}
                  alt={p.imageAlt}
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="600"
                  class="card__img"
                />
              ) : (
                <span class="card__slot-label">{c.work.slotLabel}</span>
              )}
            </span>
            <span class="card__text">
              <span class="card__name">{p.name}</span>
              <span class="card__category">{p.category}</span>
            </span>
          </button>
        </li>
      ))
    }
  </ul>
</section>

<dialog class="lightbox" data-gru-lightbox aria-label={c.work.dialogLabel}>
  <div class="lightbox__panel">
    <div class="lightbox__visual">
      {
        projects.map((p) => (
          <div class="lightbox__visual-item" data-panel-visual={p.slug} hidden>
            {p.image ? (
              <img src={p.image} alt={p.imageAlt} loading="lazy" decoding="async" />
            ) : (
              <span class="lightbox__slot-label">{c.work.slotLabel}</span>
            )}
          </div>
        ))
      }
    </div>

    <div class="lightbox__detail">
      <button type="button" class="lightbox__close" data-gru-lightbox-close>
        <span class="visually-hidden">{c.work.closeLabel}</span>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            d="M5 5l14 14M19 5L5 19"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"></path>
        </svg>
      </button>

      {
        projects.map((p) => {
          const href = caseStudyHref(locale, p.slug, p.caseStudyHref);
          return (
            <div class="lightbox__panel-body" data-panel={p.slug} hidden>
              <span class="lightbox__category">{p.category}</span>
              <h3 class="lightbox__title">{p.name}</h3>
              <p class="lightbox__body">{p.summary}</p>
              {href && (
                <a href={href} class="link-quiet lightbox__link">
                  {c.work.caseStudyLabel}
                </a>
              )}
            </div>
          );
        })
      }
    </div>
  </div>
</dialog>

<style>
  .work {
    background: var(--cream);
    padding: var(--section-y) var(--gutter);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
    padding: 0;
    background: transparent;
    border: 0;
    text-align: start;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  .card:hover {
    opacity: 0.88;
  }

  .card__slot {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 3;
    background: var(--tint);
    border: 1px solid var(--rule);
    border-radius: var(--r-portfolio);
    overflow: hidden;
  }

  .card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__slot-label {
    font-size: var(--fs-micro);
    letter-spacing: var(--ls-micro);
    text-transform: var(--tt-ui);
    color: var(--quiet);
  }

  .card__text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .card__name {
    font-family: var(--ff-display);
    font-weight: var(--fw-subhead);
    font-size: var(--fs-project);
    line-height: 1.15;
    text-transform: var(--tt-display);
    color: var(--ink-soft);
  }

  .card__category {
    font-size: var(--fs-micro);
    letter-spacing: 0.18em;
    text-transform: var(--tt-ui);
    color: var(--green);
  }

  :global(html[lang='ar']) .card__category,
  :global(html[lang='ar']) .card__slot-label {
    letter-spacing: normal;
  }

  /* ---- Lightbox -------------------------------------------------------- */
  .lightbox {
    padding: 0;
    border: 0;
    /* Overlay rgba(0,0,0,.78) per spec. The scrim lives on the dialog box
       rather than on ::backdrop so the paint is identical everywhere and does
       not depend on custom-property inheritance into a UA pseudo-element. */
    background: rgba(0, 0, 0, 0.78);
    /* Pinned explicitly rather than inheriting the UA's dialog:modal box, so
       the scrim covers the viewport identically in every engine. */
    position: fixed;
    inset: 0;
    margin: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    overflow: hidden;
  }
  /* The dialog box above already paints the full-viewport scrim at exactly
     rgba(0,0,0,.78); leaving the UA backdrop opaque would stack a second
     layer and land far darker than the spec. */
  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px;
  }

  .lightbox__panel {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: stretch;
    width: 100%;
    max-width: 1000px;
    max-height: calc(100vh - 120px);
    background: var(--cream);
    border-radius: var(--r-md);
    overflow: hidden;
  }

  /* 4/3 on the visual column gives the row a definite height, so a short
     detail column does not collapse the image slot. */
  .lightbox__visual {
    position: relative;
    background: var(--tint);
    aspect-ratio: 4 / 3;
    min-height: 0;
  }
  .lightbox__visual-item {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }
  .lightbox__visual-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lightbox__slot-label {
    font-size: var(--fs-micro);
    letter-spacing: var(--ls-micro);
    text-transform: var(--tt-ui);
    color: var(--quiet);
  }

  .lightbox__detail {
    position: relative;
    padding: 44px 40px;
    overflow-y: auto;
  }

  .lightbox__panel-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .lightbox__close {
    position: absolute;
    top: 14px;
    inset-inline-end: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--tap-min);
    height: var(--tap-min);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: var(--r-pill);
    color: var(--ink-soft);
    cursor: pointer;
  }
  .lightbox__close:hover {
    background: var(--green);
    border-color: var(--green);
    color: var(--cream);
  }

  .lightbox__category {
    font-size: var(--fs-micro);
    letter-spacing: var(--ls-micro);
    text-transform: var(--tt-ui);
    color: var(--green);
  }

  .lightbox__title {
    font-family: var(--ff-display);
    font-weight: var(--fw-display);
    font-size: var(--fs-lightbox-title);
    line-height: var(--lh-lightbox-title);
    text-transform: var(--tt-display);
  }

  .lightbox__body {
    font-weight: 300;
    font-size: 15px;
    line-height: var(--lh-body);
    color: var(--body);
  }

  .lightbox__link {
    margin-top: 10px;
  }

  :global(html[lang='ar']) .lightbox__category {
    letter-spacing: normal;
  }

  @media (max-width: 1023px) {
    .lightbox[open] {
      padding: 24px;
    }
    .lightbox__panel {
      grid-template-columns: 1fr;
      max-height: calc(100vh - 48px);
      overflow-y: auto;
    }
    .lightbox__detail {
      padding: 28px 24px 32px;
    }
  }

  @media (max-width: 767px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    .lightbox[open] {
      padding: 0;
      align-items: stretch;
    }
    .lightbox__panel {
      border-radius: 0;
      align-content: start;
      max-height: 100vh;
    }
  }
</style>

<script>
  import '../scripts/lightbox';
</script>
