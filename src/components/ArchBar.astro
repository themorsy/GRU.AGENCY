---
/**
 * A single solid green arch used as a marker beside stats (26x64), service
 * categories (20x44) and client-value items (18x40). Decorative.
 */
interface Props {
  w: number;
  h: number;
  /** Optical nudge so the bar's flat bottom lines up with the text baseline. */
  offset?: number;
  class?: string;
}
const { w, h, offset = 0, class: className = '' } = Astro.props;
---

<span
  class:list={['arch-bar', className]}
  aria-hidden="true"
  style={`width:${w}px;height:${h}px;${offset ? `margin-top:${offset}px` : ''}`}
/>
