---
import type {CollectionEntry} from 'astro:content';
import SectionHeading from './SectionHeading.astro';
interface Props {c:CollectionEntry<'locales'>['data']}
const {c}=Astro.props;
---
<section id="services" class="section tint services" aria-labelledby="services-heading"><SectionHeading number={String(c.sectionOrder.filter(k=>!['hero','cta','proof'].includes(k)).indexOf('services')+1).padStart(2,'0')} eyebrow={c.services.eyebrow} title={c.services.title} id="services-heading"/>{c.services.items.map(category=><div class="service-row"><div class="service-category"><div><p class="service-number"><bdi dir="ltr">{category.num}</bdi></p><h3>{category.label}</h3></div></div><div class="service-pills">{category.items.map(service=><span class="service-pill">{service.label}</span>)}</div></div>)}</section>

