---
/**
 * §4 What We Do.
 *
 * Tint ground, 96px 56px. Four rows, each with a 1px rule top border and
 * 34px 0 padding, laid out as a 2-column grid: 340px minmax(0,1fr) with a 48px
 * gap, items top-aligned.
 *
 * The geometry is load-bearing: at 300px/40px/20px an earlier version let a
 * wrapped pill row collide with the category title. The left column stays at
 * 340px and pills stay 16px and no-wrap.
 *
 * Every service is a real link. While site.servicePagesLive is false they
 * point at the lead form rather than a service page that does not exist yet —
 * see serviceHref() in src/content/index.ts.
 */
import Arches from './Arches.astro';
import ArchBar from './ArchBar.astro';
import { getContent, serviceHref, type Locale } from '../content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = getContent(locale);
---

<section id="services" class="services" aria-labelledby="services-heading">
  <div class="opener services__opener">
    <Arches />
    <span class="eyebrow">{c.services.eyebrow}</span>
    <h2 id="services-heading" class="h2">{c.services.heading}</h2>
  </div>

  {
    c.services.categories.map((cat) => (
      <div class="cat">
        <div class="cat__head">
          <ArchBar w={20} h={44} offset={4} />
          <div class="cat__title">
            <span class="cat__num">{cat.num}</span>
            <h3 class="h3 cat__name">{cat.label}</h3>
          </div>
        </div>
        <ul class="pills">
          {cat.items.map((item) => (
            <li>
              <a href={serviceHref(locale, item)} class="pill">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</section>

<style>
  .services {
    background: var(--tint);
    padding: var(--section-y) var(--gutter);
  }

  .services__opener {
    margin-bottom: 40px;
  }

  .cat {
    display: grid;
    grid-template-columns: 340px minmax(0, 1fr);
    gap: 48px;
    border-top: 1px solid var(--rule);
    padding: 34px 0;
    align-items: start;
  }

  .cat__head {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .cat__title {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .cat__num {
    font-size: var(--fs-micro);
    letter-spacing: var(--ls-num);
    color: var(--quiet);
  }

  .cat__name {
    overflow-wrap: anywhere;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 12px;
    align-items: flex-start;
    align-content: flex-start;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    /* 11px 20px per spec; min-height lifts the box to the 44px tap-target
       floor the accessibility section requires (adds ~1px at desktop size). */
    min-height: var(--tap-min);
    padding: 11px 20px;
    border: 1px solid var(--rule);
    border-radius: var(--r-pill);
    font-size: var(--fs-pill);
    line-height: 1.3;
    color: var(--ink-soft);
    white-space: nowrap;
    transition: background-color 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  }
  .pill:hover {
    background: var(--green);
    color: var(--cream);
    border-color: var(--green);
  }

  @media (max-width: 1023px) {
    .cat {
      grid-template-columns: 260px minmax(0, 1fr);
      gap: 32px;
    }
  }

  /* Mobile: the category stacks above its pills. */
  @media (max-width: 767px) {
    .services__opener {
      margin-bottom: 26px;
    }
    .cat {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 22px 0;
    }
    .pills {
      gap: 8px 10px;
    }
    .pill {
      padding: 7px 14px;
      white-space: normal;
    }
  }
</style>
