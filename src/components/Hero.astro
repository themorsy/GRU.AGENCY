---
import type {CollectionEntry} from 'astro:content';
import Text from './Text.astro';
interface Props {c:CollectionEntry<'locales'>['data']}
const {c}=Astro.props;
---
<section class="hero" aria-labelledby="hero-heading">
  {c.hero.poster&&<img class="hero-poster" src={c.hero.poster} width="1440" height="720" alt="" decoding="async" fetchpriority="high"/>}
  {/* Client correction: video placement annotations are review-only, not website copy. */}
  {c.hero.video&&<video class="hero-video" data-video data-desktop={c.hero.video} data-webm={c.hero.videoWebm} data-mobile={c.hero.videoMobile} poster={c.hero.poster} preload="none" muted loop playsinline aria-hidden="true" tabindex="-1"><source data-hero-webm type="video/webm"/><source data-hero-mp4 type="video/mp4"/></video>}
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="hero-content"><h1 id="hero-heading"><Text value={c.hero.headline}/></h1><p><Text value={c.hero.body}/></p><div class="hero-actions"><a class="button" href={c.sectionOrder.includes('form')?'#lead':`/${c.lang}/#lead`}>{c.ui.book}</a><a class="button button-outline" href={c.sectionOrder.includes('portfolio')?'#work':`/${c.lang}/#work`}>{c.ui.work}</a></div></div>
</section>

