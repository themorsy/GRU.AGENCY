---
/**
 * §12 Floating WhatsApp button — every page, both breakpoints.
 *
 * fixed right:28px bottom:28px, green pill with a cream glyph and the
 * "WhatsApp" label, shadow 0 12px 30px rgba(0,0,0,.35), hover inverts to
 * #0B0B0B. On mobile it becomes a 48px circular icon-only button at
 * right:20px bottom:22px. Opens wa.me in a new tab.
 *
 * "Clear of the footer CTA": while the footer is on screen it steps aside, so
 * it never lands on top of the footer's own WhatsApp pill — the footer already
 * carries the same call to action twice at that point. Handled in
 * ../scripts/whatsapp.ts with an IntersectionObserver; with no JS it simply
 * stays put, which is the safe default.
 */
import { getContent, site, type Locale } from '../content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = getContent(locale);
---

<a
  class="wa"
  href={site.whatsappHref}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={c.whatsapp.ariaLabel}
  data-gru-wa>
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
    <path
      d="M21 12a9 9 0 0 1-13.1 8L3 21l1.1-4.7A9 9 0 1 1 21 12z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <path
      d="M8.6 9.2c0 3.2 2.9 6 6.1 6 .7 0 1.3-.5 1.3-1.2v-.9l-2.2-.7-.8.9c-1-.5-1.8-1.3-2.3-2.3l.9-.8-.7-2.2h-.9c-.7 0-1.4.5-1.4 1.2z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  <span class="wa__label">{c.whatsapp.label}</span>
</a>

<style>
  .wa {
    position: fixed;
    inset-inline-end: 28px;
    inset-block-end: 28px;
    /* Above the sticky header (90) and every section; below the lightbox,
       which is in the top layer. */
    z-index: 140;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: var(--tap-min);
    padding: 14px 20px;
    border-radius: var(--r-pill);
    background: var(--green);
    color: var(--cream);
    font-size: var(--fs-btn);
    letter-spacing: var(--ls-btn);
    text-transform: var(--tt-ui);
    box-shadow: var(--shadow-fab);
    transition: background-color 0.2s ease, opacity 0.25s ease, transform 0.25s ease;
  }

  .wa:hover {
    background: var(--ink-soft);
    color: var(--cream);
  }

  /* Stepped aside while the footer is on screen. */
  .wa[data-tucked='true'] {
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
  }

  @media (max-width: 767px) {
    .wa {
      inset-inline-end: 20px;
      inset-block-end: 22px;
      width: 48px;
      height: 48px;
      min-height: 48px;
      padding: 0;
      justify-content: center;
    }
    .wa__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa {
      transition: none;
    }
  }
</style>

<script>
  import '../scripts/whatsapp';
</script>
