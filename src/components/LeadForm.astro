---
/**
 * §10 Book a Call.
 *
 * Cream, 96px 56px, 2-column grid 1fr / 1.2fr with a 72px gap. Fields are
 * underline-only: transparent background, no border but a 1px rule bottom,
 * 12px 0 padding, 15px text, 11px uppercase label above, underline turns green
 * on focus.
 *
 * Submission is Netlify Forms. The form works with JavaScript switched off:
 * it is a real POST with an `action` pointing at the language-matched
 * thank-you page, which Netlify honours after accepting the submission.
 * ../scripts/form.ts then layers on inline blur validation, the submitting
 * state, the dataLayer push and a client-side redirect, so the enhanced path
 * and the no-JS path both land on the same URL.
 *
 * A `locale` field rides along so both languages can share one form inbox.
 */
import Arches from './Arches.astro';
import { getContent, serviceOptions, site, thankYouHref, type Locale } from '../content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = getContent(locale);
const groups = serviceOptions(c);
const thankYou = thankYouHref(locale);
---

<section id="lead" class="lead" aria-labelledby="lead-heading">
  <div class="lead__intro">
    <div class="opener">
      <Arches />
      <span class="eyebrow">{c.form.eyebrow}</span>
      <h2 id="lead-heading" class="h2">{c.form.heading}</h2>
    </div>
    <p class="lead__text">{c.form.intro}</p>
    <a
      href={site.whatsappHref}
      class="lead__whatsapp"
      target="_blank"
      rel="noopener noreferrer">{c.form.whatsappLabel}</a
    >
    <p class="lead__required">{c.form.requiredNote}</p>
  </div>

  <form
    class="form"
    name={site.form.netlifyName}
    method="POST"
    action={thankYou}
    data-netlify="true"
    data-netlify-honeypot={site.form.honeypot}
    data-gru-form
    data-thank-you={thankYou}
    data-submitting-label={c.form.submitting}
    data-submit-label={c.form.submit}
    data-submit-event={site.submitEvent}
    novalidate>
    <input type="hidden" name="form-name" value={site.form.netlifyName} />
    <input type="hidden" name="locale" value={locale} />
    <p class="visually-hidden">
      <label>
        {site.form.honeypot}
        <input name={site.form.honeypot} tabindex="-1" autocomplete="off" />
      </label>
    </p>

    {
      c.form.fields.map((f) => {
        const id = `field-${f.name}`;
        const errId = `${id}-error`;
        return (
          <div class="field" data-span={f.span} data-field={f.name}>
            <label class="field__label" for={id}>
              {f.label}
            </label>

            {f.type === 'select' ? (
              <select
                class="field__control"
                id={id}
                name={f.name}
                required={f.required}
                aria-describedby={errId}
                data-error-required={f.errorRequired}>
                <option value="">{c.form.selectPlaceholder}</option>
                {groups.map((g) => (
                  <optgroup label={g.group}>
                    {g.options.map((o) => (
                      <option value={o}>{o}</option>
                    ))}
                  </optgroup>
                ))}
              </select>
            ) : f.type === 'textarea' ? (
              <textarea
                class="field__control field__control--textarea"
                id={id}
                name={f.name}
                rows="4"
                placeholder={f.placeholder}
                required={f.required}
                aria-describedby={errId}
                data-error-required={f.errorRequired}
              />
            ) : (
              <input
                class="field__control"
                id={id}
                name={f.name}
                type={f.type}
                placeholder={f.placeholder}
                required={f.required}
                autocomplete={f.autocomplete}
                aria-describedby={errId}
                data-error-required={f.errorRequired}
                data-error-format={f.errorFormat}
              />
            )}

            <p class="field__error" id={errId} data-error hidden></p>
          </div>
        );
      })
    }

    <p class="form__error" data-form-error role="alert" hidden>{c.form.submitError}</p>

    <button type="submit" class="btn btn--green form__submit" data-gru-form-submit>
      {c.form.submit}
    </button>
  </form>
</section>

<style>
  .lead {
    background: var(--cream);
    padding: var(--section-y) var(--gutter);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 72px;
  }

  .lead__intro {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
  }

  .lead__text {
    font-weight: 300;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--body);
    max-width: 400px;
  }

  .lead__whatsapp {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    gap: 10px;
    font-size: var(--fs-btn);
    letter-spacing: 0.12em;
    text-transform: var(--tt-ui);
    color: var(--green);
  }
  .lead__whatsapp:hover {
    color: var(--ink-soft);
  }

  .lead__required {
    font-size: var(--fs-field-label);
    letter-spacing: var(--ls-field-label);
    text-transform: var(--tt-ui);
    color: var(--quiet);
  }

  /* ---- Form ------------------------------------------------------------ */
  .form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    align-content: start;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .field[data-span='2'] {
    grid-column: span 2;
  }

  .field__label {
    font-size: var(--fs-field-label);
    letter-spacing: var(--ls-field-label);
    text-transform: var(--tt-ui);
    color: var(--quiet);
  }

  .field__control {
    width: 100%;
    min-height: var(--tap-min);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--rule);
    border-radius: 0;
    padding: 12px 0;
    font-family: var(--ff-body);
    font-size: 15px;
    line-height: 1.4;
    color: var(--ink-soft);
    outline: none;
    transition: border-color 0.18s ease;
  }
  .field__control:focus {
    border-bottom-color: var(--green);
  }
  /* The underline is the field, so the focus ring is drawn on it rather than
     as an offset box that would float away from a borderless control. */
  .field__control:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 4px;
  }

  .field__control--textarea {
    resize: vertical;
    min-height: 96px;
  }

  select.field__control {
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--green) 50%),
      linear-gradient(135deg, var(--green) 50%, transparent 50%);
    background-position: calc(100% - 10px) calc(50% + 2px), calc(100% - 5px) calc(50% + 2px);
    background-size: 5px 5px, 5px 5px;
    background-repeat: no-repeat;
    padding-inline-end: 26px;
  }
  :global(html[dir='rtl']) select.field__control {
    background-position: 10px calc(50% + 2px), 5px calc(50% + 2px);
  }

  .field__control[aria-invalid='true'] {
    border-bottom-color: var(--error);
  }

  .field__error {
    font-size: 12px;
    line-height: 1.45;
    color: var(--error);
  }

  .form__error {
    grid-column: span 2;
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body-sm);
    color: var(--error);
  }

  .form__submit {
    grid-column: span 2;
    justify-self: start;
    padding: 18px 40px;
    margin-top: 12px;
  }
  .form__submit[disabled] {
    opacity: 0.6;
    cursor: progress;
  }

  :global(html[lang='ar']) .field__control {
    font-family: var(--ff-arabic);
    text-align: right;
  }
  :global(html[lang='ar']) .lead__text {
    max-width: 420px;
  }

  @media (max-width: 1023px) {
    .lead {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 767px) {
    .form {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .field[data-span='2'] {
      grid-column: span 1;
    }
    .form__error,
    .form__submit {
      grid-column: span 1;
    }
    .form__submit {
      width: 100%;
      justify-self: stretch;
    }
  }
</style>

<script>
  import '../scripts/form';
</script>
