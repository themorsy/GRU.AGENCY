---
import type {CollectionEntry} from 'astro:content';
import LineIcon from './LineIcon.astro';
import SectionHeading from './SectionHeading.astro';
interface Props {c:CollectionEntry<'locales'>['data']}
const {c}=Astro.props;
---
<section id="value" class="section client-value" aria-labelledby="value-heading"><SectionHeading number={String(c.sectionOrder.filter(k=>!['hero','cta','proof'].includes(k)).indexOf('value')+1).padStart(2,'0')} eyebrow={c.value.eyebrow} title={c.value.title} id="value-heading"/><div class="value-grid">{c.value.items.map(v=><article class="value-item" data-reveal><LineIcon name={v.icon}/><div><h3>{v.title}</h3><p>{v.body}</p></div></article>)}</div></section>
