---
import {getCollection} from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PageSections from '../../../components/PageSections.astro';
import Footer from '../../../components/Footer.astro';
export async function getStaticPaths(){
 const pages=await getCollection('pages');
 const slugs=pages.map(p=>p.data.slug);
 if(new Set(slugs).size!==slugs.length)throw new Error('Duplicate campaign URL');
 return pages.filter(p=>p.data.published&&p.data.slug!=='home').flatMap(p=>p.data.languages.map(lang=>({params:{lang,slug:p.data.slug},props:{c:p.data.content[lang],slug:p.data.slug,languages:p.data.languages,gtmId:p.data.gtmId}})));
}
const {c,slug,languages,gtmId}=Astro.props;
---
<Base c={c} slug={slug} languages={languages} gtmId={gtmId}><PageSections c={c}/><Footer c={c} slot="footer"/></Base>
