{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gru-agency",
  "compatibility_date": "2026-09-11",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "ratelimits": [{"name":"LEAD_RATE_LIMITER","namespace_id":"74260911","simple":{"limit":5,"period":60}}],
  "vars": {"LEAD_FORM_ENABLED":"true","SITE_INDEXABLE":"false"}
}
