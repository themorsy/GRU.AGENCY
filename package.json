{
  "name": "gru-marketing-codex",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4332",
    "build": "astro check && tsc -p worker/tsconfig.json && astro build",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate-build.mjs",
    "postbuild": "node scripts/assert-assets.mjs",
    "worker:dev": "wrangler dev --port 4333",
    "check:worker": "tsc -p worker/tsconfig.json"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.0.0",
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^24",
    "fontkit": "^2.0.4",
    "linkedom": "^0.18.12",
    "postcss": "^8.5.28",
    "typescript": "^5.9.2",
    "wrangler": "^4.131.1"
  }
}
